{
  "name": "dev-companion",
  "version": "0.1.0",
  "private": true,
  "author": "Alaa El-Basuony",
  "license": "UNLICENSED",
  "description": "Chrome extension for capturing and debugging frontend API traffic.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "build:e2e": "node scripts/build.mjs --e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && node tests/e2e/run-e2e.mjs && node tests/e2e/run-e2e-realtime.mjs && node tests/e2e/run-e2e-cdp.mjs && node tests/e2e/run-e2e-ssr.mjs",
    "mock-server": "node test-page/mock-server.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "test:e2e:realtime": "npm run build:e2e && node tests/e2e/run-e2e-realtime.mjs",
    "test:e2e:ssr": "npm run build:e2e && node tests/e2e/run-e2e-ssr.mjs"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@microsoft/signalr": "^10.0.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.10",
    "puppeteer": "^25.14.0",
    "socket.io": "^4.8.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  }
}
